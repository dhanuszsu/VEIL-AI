{
  "name": "privatesight",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extension",
    "server",
    "shared",
    "agentic-browser",
    "browser-app"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace=extension",
    "build:extension": "npm run build --workspace=extension",
    "dev:server": "npm run dev --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build:extension && npm run build:server",
    "agent:browser": "npm run start --workspace=@privatesight/agentic-browser --",
    "agent:demo": "npm run demo --workspace=@privatesight/agentic-browser",
    "browser": "npm run dev --workspace=@privatesight/browser-app",
    "test": "vitest run",
    "lint": "npm run lint --workspaces",
    "demo": "npx serve -l 3002 demo",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "core-js@3.29.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.2": true
  }
}
